// Tapes: 3 (Input 1, Input 2, Output)

// Case 1: Match (Specific Rule Wins)
// Input ($x, $x) matches logic -> Write Y
compare ($x, $x, BLANK)  compare  ($x, $x, Y)  (RIGHT, RIGHT, RIGHT)

// Case 2: Mismatch (Generic Rule Fallback)
// Input ($x, $y) catches everything else -> Write N
compare ($x, $y, BLANK)  compare  ($x, $y, N)  (RIGHT, RIGHT, RIGHT)

// Halting
compare (BLANK, BLANK, BLANK)  halt  (BLANK, BLANK, BLANK) (STAY, STAY, STAY)